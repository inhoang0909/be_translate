# ==========================================
# Server Configuration
# ==========================================
PORT=5600
HOST=0.0.0.0
SWAGGER_URL=http://localhost:5600

# ==========================================
# Database Configuration
# ==========================================
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=translate_db
DB_USER=root
DB_PASS=secret

# ==========================================
# Authentication & JWT
# ==========================================
JWT_SECRET=change-this-secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRE=30d

# ==========================================
# AI / Ollama Embedding & LLM
# ==========================================
OLLAMA_MODEL=qwen3:8b
EMBED_MODEL_NAME=embeddinggemma:latest
EMBED_REQUEST_TIMEOUT_MS=30000
OLLAMA_EMBED_URL=http://your-ollama-host:11437/api/embeddings

# Optional Ollama Endpoints for apiManager
# OLLAMA_API_URL_1=http://your-ollama-host:11434/api/generate

# ==========================================
# Workflow & Mistype Correction
# ==========================================
CORRECT_MISTYPE_URL=http://your-workflow-host/v1/workflows/run
CORRECT_MISTYPE_TOKEN=

# ==========================================
# Qdrant Vector Database
# ==========================================
QDRANT_URL=http://your-qdrant-host:6333
QDRANT_API_KEY=your-qdrant-api-key

# ==========================================
# Notifications / Webhooks
# ==========================================
SYNO_CHANNEL_URL=http://your-syno-host/api/v1/syno-channel/send

# ==========================================
# Global Service API
# ==========================================
GLOBAL_API_URL=

